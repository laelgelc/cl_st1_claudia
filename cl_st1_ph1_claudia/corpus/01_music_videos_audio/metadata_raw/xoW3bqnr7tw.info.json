/xoW3bqnr7tw/hqdefault.jpg?sqp=-oaymwEjCNACELwBSFryq4qpAxUIARUAAAAAGAElAADIQj0AgKJDeAE=&rs=AOn4CLAr7TgoMb0ABGBUmvVdZJoh3X0dpQ", "height": 188, "width": 336, "preference": -7, "id": "33", "resolution": "336x188"}, {"url": "https://i.ytimg.com/vi/xoW3bqnr7tw/hqdefault.jpg", "height": 360, "width": 480, "preference": -7, "id": "34", "resolution": "480x360"}, {"url": "https://i.ytimg.com/vi_webp/xoW3bqnr7tw/hqdefault.webp", "preference": -6, "id": "35"}, {"url": "https://i.ytimg.com/vi/xoW3bqnr7tw/sddefault.jpg", "preference": -5, "id": "36"}, {"url": "https://i.ytimg.com/vi_webp/xoW3bqnr7tw/sddefault.webp", "preference": -4, "id": "37"}, {"url": "https://i.ytimg.com/vi/xoW3bqnr7tw/hq720.jpg", "preference": -3, "id": "38"}, {"url": "https://i.ytimg.com/vi_webp/xoW3bqnr7tw/hq720.webp", "preference": -2, "id": "39"}, {"url": "https://i.ytimg.com/vi/xoW3bqnr7tw/maxresdefault.jpg", "height": 1080, "width": 1920, "preference": -1, "id": "40", "resolution": "1920x1080"}, {"url": "https://i.ytimg.com/vi_webp/xoW3bqnr7tw/maxresdefault.webp", "preference": 0, "id": "41"}], "thumbnail": "https://i.ytimg.com/vi/xoW3bqnr7tw/maxresdefault.jpg", "description": "Official music video for Hootie & The Blowfish - \"Hold My Hand\" from the album 'Cracked Rear View' (1994). \n\nOUT NOW: The complete Atlantic discography of Hootie & The Blowfish available for the first time together on both 6LP and 5CD box sets. This essential collection features their 22X platinum debut Cracked Rear View, alongside the classic albums Fairweather Johnson, Musical Chairs, Scattered, Smothered, and Covered, and Hootie & The Blowfish. Get your copy now https://Rhino.lnk.to/TAY\n\n\"Hold My Hand\" features a backing vocal from David Crosby.\n\n🔔 Subscribe to Hootie & the Blowfish channel and ring the bell to turn on notifications https://rhino.lnk.to/HATBSubscribe\n\n🔊 Listen to Hootie & the Blowfish https://rhino.lnk.to/HATBListen\n\nStay in touch with Hootie & the Blowfish…\n \n🌐 Website https://www.hootie.com/\n📣 https://www.facebook.com/hootieandtheblowfish/  \n📸 https://www.instagram.com/hootieofficial/\n⌨ https://twitter.com/HootieTweets\n\n*******************\n\nWith their unreplicable blend of blues, rock, soul and the pure joy of making music–Hootie & the Blowfish are unparalleled in their uniquely universal sound. The band fine tuned this sound playing frat parties and gigs at the University of South Carolina. The transition from playing covers to original songs was warmly received by audiences around the southeast and the band released their first full album “Cracked Rear View” in 1994 to legendary success. With hits like “Only Wanna Be With You”, “Hold My Hand” and “Let Her Cry” Cracked Rear View remains the 9th best selling album in music history. \n\nSubscribe to keep up with all Hootie & the Blowfish’s latest news and releases.", "channel_id": "UCFKoHZs7XJOpmN9HTPI4-qA", "channel_url": "https://www.youtube.com/channel/UCFKoHZs7XJOpmN9HTPI4-qA", "duration": 256, "view_count": 37588924, "age_limit": 0, "webpage_url": "https://www.youtube.com/watch?v=xoW3bqnr7tw", "categories": ["Music"], "tags": ["Hootie & The Blowfish", "Hootie & The Blowfish Music Videos", "Hootie & The Blowfish Videos", "Hootie & The Blowfish Songs", "Hootie & The Blowfish playlist", "Hootie & The Blowfish music", "Hootie & The Blowfish lyrics", "Hootie & The Blowfish exitos", "Musica de Hootie & The Blowfish", "90s Music", "90s playlist", "Roots rock", "Rock de los 90", "hold my hand", "hold my hand video", "hold my hand live", "hold my hand lyrics", "hootie & the blowfish hold my hand", "hold my hand hootie & the blowfish"], "playable_in_embed": true, "live_status": "not_live", "media_type": "video", "_format_sort_fields": ["quality", "res", "fps", "hdr:12", "source", "vcodec", "channels", "acodec", "lang", "proto"], "automatic_captions": {}, "subtitles": {}, "comment_count": 9100, "heatmap": [{"start_time": 0.0, "end_time": 2.56, "value": 1.0}, {"start_time": 2.56, "end_time": 5.12, "va