bland/\n\n— SUBSCRIBE —\nSubscribe for more Clubland classics: https://www.youtube.com/@SteveAATW?sub_confirmation=1\n\n— MORE CLUBLAND —\n▶ Clubland Classix Playlist: https://www.youtube.com/playlist?list=PLEiTbNWDe3L8UBQOw5zhiiKFKqiUrj6SF\n▶ More Cascada on AATW: https://www.youtube.com/playlist?list=PL9D6210A426CD7759\n\n— CREDITS —\nArtist: Cascada\nTrack: Everytime We Touch\nLabel: All Around The World (AATW) / Universal Music\nReleased: 2005\nProducers: DJ Manian, Yanou\n\n#cascada #everytimewetouch #eurodance #NatalieHorler #clubland #aatw  #allaroundtheworld #ClublandClassix #00s #ClassicClub #DanceMusic #UKDance #Trance #ClubClassic", "channel_id": "UCqZKc23a7IWL0cUp1nvoLFA", "channel_url": "https://www.youtube.com/channel/UCqZKc23a7IWL0cUp1nvoLFA", "duration": 215, "view_count": 274835122, "age_limit": 0, "webpage_url": "https://www.youtube.com/watch?v=4G6QDNC4jPs", "categories": ["Music"], "tags": ["cascada", "everytime", "every", "time", "we", "touch", "aatw", "clubland", "tv", "Eurodance (Composition Type)", "Music (TV Genre)", "Everytime We Touch (Canonical Version)", "Video Clip (Media Genre)"], "playable_in_embed": true, "live_status": "not_live", "media_type": "video", "_format_sort_fields": ["quality", "res", "fps", "hdr:12", "source", "vcodec", "channels", "acodec", "lang", "proto"], "automatic_captions": {}, "subtitles": {}, "comment_count": 60000, "heatmap": [{"start_time": 0.0, "end_time": 2.15, "value": 0.5486768058950349}, {"start_time": 2.15, "end_time": 4.3, "value": 0.301034760934897}, {"start_time": 4.3, "end_time": 6.45, "value": 0.37382266687185023}, {"start_time": 6.45, "end_time": 8.6, "value": 0.42877330702671906}, {"start_time": 8.6, "end_time": 10.75, "value": 0.462125820363079}, {"start_time": 10.75, "end_time": 12.9, "value": 0.47670883481001997}, {"start_time": 12.9, "end_time": 15.05, "value": 0.5098479197964353}, {"start_time": 15.05, "end_time": 17.2, "value": 0.5376714398335547}, {"start_time": 17.2, "end_time": 19.35, "valu