 films, including Rock, Rock, Rock and Mr. Rock & Roll.", "channel_id": "UCUpvc_GJLW7N663BgT9bVDw", "channel_url": "https://www.youtube.com/channel/UCUpvc_GJLW7N663BgT9bVDw", "duration": 132, "view_count": 330931, "age_limit": 0, "webpage_url": "https://www.youtube.com/watch?v=_EoebOJqjGM", "categories": ["People & Blogs"], "tags": ["Jim Dandy (Musical Recording)", "LaVern Baker (Musical Artist)", "Rhythm And Blues (Musical Genre)", "golden oldies", "1950s music", "The Gliders"], "playable_in_embed": true, "live_status": "not_live", "media_type": "video", "_format_sort_fields": ["quality", "res", "fps", "hdr:12", "source", "vcodec", "channels", "acodec", "lang", "proto"], "automatic_captions": {}, "subtitles": {}, "comment_count": 286, "like_count": 4505, "channel": "Daily Doo Wop", "channel_follower_count": 11300, "uploader": "Daily Doo Wop", "uploader_id": "@dailydoowop5301", "uploader_url": "https://www.youtube.com/@dailydoowop5301", "upload_date": "20150220", "timestamp": 1424407306, "availability": "public", "webpage_url_basename": "watch", "webpage_url_domain": "youtube.com", "extractor": "youtube", "extractor_key": "Youtube", "display_id": "_EoebOJqjGM", "fulltitle": "\"Jim Dandy\" by LaVern Baker", "duration_string": "2:12", "is_live": false, "was_live": false, "epoch": 1788311115, "format_id": "94", "url": "https://manifest.googlevideo.com/api/manifest/hls_playlist/expire/1788332712/ei/R3aXarS5O--eobIP5_TNqQo/ip/18.229.136.40/id/fc4a1e6ce26a8c63/itag/94/source/youtube/requiressl/yes/ratebypass/yes/pfa/1/sgoap/clen%3D2131948%3Bdur%3D131.680%3Bgir%3Dyes%3Bitag%3D140%3Blmt%3D1730505760860646/sgovp/clen%3D935115%3Bdur%3D131.631%3Bgir%3Dyes%3Bitag%3D135%3Blmt%3D1730506956310515/rqh/1/hls_chunk_host/rr4---sn-bg0s7nls.googlevideo.com/xpc/EgVo2aDSNQ%3D%3D/cps/308/met/1788311111,/mh/Nq/mm/31,26/mn/sn-bg0s7nls,sn-hp57yne7/ms/au,onr/mv/m/mvi/4/pl/17/rms/au,au/initcwndbps/3490000/siu/1/bui/AR3QkAnU6lijSPTezn1878T1_I7_qoFlDwC11bAAKO8u4Hw5_kYP8xw1XeVJC9ML71a1z76QzQ/spc/K