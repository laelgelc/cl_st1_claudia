p=-oaymwEiCKgBEF5IWvKriqkDFQgBFQAAAAAYASUAAMhCPQCAokN4AQ==&rs=AOn4CLCENyvH-YJs85QYOtxiNB18EKd2qg", "height": 94, "width": 168, "preference": -7, "id": "30", "resolution": "168x94"}, {"url": "https://i.ytimg.com/vi/h_D3VFfhvs4/hqdefault.jpg?sqp=-oaymwEiCMQBEG5IWvKriqkDFQgBFQAAAAAYASUAAMhCPQCAokN4AQ==&rs=AOn4CLBaxOctUVr9DjGr4OvFskVs6BG1AA", "height": 110, "width": 196, "preference": -7, "id": "31", "resolution": "196x110"}, {"url": "https://i.ytimg.com/vi/h_D3VFfhvs4/hqdefault.jpg?sqp=-oaymwEjCPYBEIoBSFryq4qpAxUIARUAAAAAGAElAADIQj0AgKJDeAE=&rs=AOn4CLAdvQLmXi0gY-4qVBIg_uyR8NqMAA", "height": 138, "width": 246, "preference": -7, "id": "32", "resolution": "246x138"}, {"url": "https://i.ytimg.com/vi/h_D3VFfhvs4/hqdefault.jpg?sqp=-oaymwEjCNACELwBSFryq4qpAxUIARUAAAAAGAElAADIQj0AgKJDeAE=&rs=AOn4CLBVuJy22s25yxyp1ZgHzXKZQeQaQQ", "height": 188, "width": 336, "preference": -7, "id": "33", "resolution": "336x188"}, {"url": "https://i.ytimg.com/vi/h_D3VFfhvs4/hqdefault.jpg", "height": 360, "width": 480, "preference": -7, "id": "34", "resolution": "480x360"}, {"url": "https://i.ytimg.com/vi_webp/h_D3VFfhvs4/hqdefault.webp", "preference": -6, "id": "35"}, {"url": "https://i.ytimg.com/vi/h_D3VFfhvs4/sddefault.jpg", "preference": -5, "id": "36"}, {"url": "https://i.ytimg.com/vi_webp/h_D3VFfhvs4/sddefault.webp", "preference": -4, "id": "37"}, {"url": "https://i.ytimg.com/vi/h_D3VFfhvs4/hq720.jpg", "preference": -3, "id": "38"}, {"url": "https://i.ytimg.com/vi_webp/h_D3VFfhvs4/hq720.webp", "preference": -2, "id": "39"}, {"url": "https://i.ytimg.com/vi/h_D3VFfhvs4/maxresdefault.jpg", "height": 1080, "width": 1920, "preference": -1, "id": "40", "resolution": "1920x1080"}, {"url": "https://i.ytimg.com/vi_webp/h_D3VFfhvs4/maxresdefault.webp", "preference": 0, "id": "41"}], "thumbnail": "https://i.ytimg.com/vi/h_D3VFfhvs4/maxresdefault.jpg", "description": "The short film for Michael Jackson's \"Smooth Criminal\" was the centerpiece of the feature film Moonwalker, and featured the debut of Michael's iconic \"anti-gravity lean.\" Inspired in part by Fred Astaire's \"Girl Hunt Ballet\" dance number in the film The Band Wagon, \"Smooth Criminal\" was named Best Video at the BRIT Awards, Broadcast Film Critics Association and the People's Choice Awards.\r\nListen to Michael Jackson: https://MichaelJackson.lnk.to/_listenYD\r\nSubscribe to the official Michael Jackson YouTube Channel: https://MichaelJackson.lnk.to/subscribeYD\r\n\r\nWatch more Michael Jackson videos: https://MichaelJackson.lnk.to/_listenYC/youtube\r\n\r\nFollow Michael Jackson: \r\nFacebook: https://MichaelJackson.lnk.to/_followFI \r\nTwitter: https://MichaelJackson.lnk.to/_followTI\r\nInstagram: https://MichaelJackson.lnk.to/_followII \r\nWebsite: https://MichaelJackson.lnk.to/_followWI \r\nSpotify: https://MichaelJackson.lnk.to/_followSI\r\n\r\nWritten and Composed by Michael Jackson\r\nProduced by Quincy Jones for Quincy Jones Productions\r\nCo-Produced by Michael Jackson for MJJ Productions, Inc.\r\nFrom the album Bad, released August 31, 1987\r\nReleased as a single October 21, 1988\r\n\r\nTHE SHORT FILM\r\nDirector: Colin Chilvers\r\nPrimary Production Location: Los Angeles, California\r\n\r\nMichael Jackson's short film for \"Smooth Criminal\" was the sixth of nine short films produced for recordings from Bad, one of the best selling albums of all time. The \"Smooth Criminal\" single hit No. 1 in Spain and The Netherlands and reached the Top 10 in the UnitedStates, the United Kingdom, France, Germany, Ireland and Switzerland. In the United States, \"Smooth Criminal\" reached the Top 10 of the Billboard Hot 100-the sixth single from Bad to do so-as well as Billboard's Hot Dance Club Play and Hot R&B/Hip-Hop Singles charts.\r\n\r\nIn addition to being a standalone short film, \"Smooth Criminal\" became the centerpiece of Michael's most ambitious film project at the time, Moonwalker, a feature-length film that was released theatrically in various countries outside of the United States. In the \"Smooth Criminal\" portion of the film, Michael and his friends face off against the notorious drug lord Mr. Big (Joe Pesci) and attempt to foil his plot to get the children of the world hooked on drugs-but of course, in the end, Michael defeats the villain.\r\n\r\nThe musical portion of \"Smooth Criminal\" takes place in the magical \"Club '30s,\" where Michael instructed his friends to meet him. While Katie (Kellie Parker), Zeke (Brandon Adams) and Sean (Sean Lennon) find the club to belong abandoned, Club '30s springs to life when Michael shows up, wearing a blue and white pinstripe suit and fedora.\r\n\r\nAs the kids watch through the window, Michael flips a coin into the jukebox and leads the club patrons through a dazzling performance to \"Smooth Criminal.\" Here, Michael shows off updated versions of his signature dance moves. He also debuts one of his most iconic dance moves: the \"anti-gravity lean,\" a seemingly impossible move.\r\n\r\n#MichaelJackson #SmoothCriminal", "channel_id": "UCulYu1HEIa7f70L2lYZWHOw", "channel_url": "https://www.youtube.com/channel/UCulYu1HEIa7f70L2lYZWHOw", "duration": 566, "view_count": 1330670175, "age_limit": 0, "webpage_url": "https://www.youtube.com/watch?v=h_D3VFfhvs4", "categories": ["Music"], "tags": ["michael jackson", "smooth criminal", "michael jackson smooth criminal", "maicol jackson", "مايكل جاكسون michael jackson songs", "smooth criminal michael jackson", "maicon jackson", "マイケルジャクソン", "annie are you ok", "michelle jackson", "майкл джексон", "ayuwoki", "mickelson jackson", "thriller", "beat it", "billie jean", "polo", "polo smooth criminal", "smooth criminal polo", "Bad Man (Smooth Criminal)", "polo bad man", "bad man polo", "halloween", "halloween songs", "halloween party", "Confident", "Dance Pop", "Energetic"], "playable_in_embed": true, "live_status": "not_live", "media_type": "video", "_format_sort_fields": ["quality", "res", "fps", "hdr:12", "source", "vcodec", "channels", "acodec", "lang", "proto"], "a