 dozens of unreleased recordings including lost mixes sourced from producer Felix Pappalardi’s personal tapes and new rarities collections. The 5CD additionally includes expanded live recordings and a 24-page hardback book with rare images and new liner notes by Jim Farber.\n \nReleases 12th June 2026: https://cream.lnk.to/WheelsOfFireID \n\n#Cream #WheelsOfFire", "channel_id": "UC5ABrPrntAVubIiXOWaS_RQ", "channel_url": "https://www.youtube.com/channel/UC5ABrPrntAVubIiXOWaS_RQ", "duration": 300, "view_count": 809556, "age_limit": 0, "webpage_url": "https://www.youtube.com/watch?v=-DQdB7dTm1A", "categories": ["People & Blogs"], "tags": [], "playable_in_embed": true, "live_status": "not_live", "media_type": "video", "_format_sort_fields": ["quality", "res", "fps", "hdr:12", "source", "vcodec", "channels", "acodec", "lang", "proto"], "automatic_captions": {}, "subtitles": {}, "comment_count": 186, "heatmap": [{"start_time": 0.0, "end_time": 3.01, "value": 1.0}, {"start_time": 3.01, "end_time": 6.02, "value": 0.4806239933053708}, {"start_time": 6.02, "end_time": 9.03, "value": 0.4738288235962176}, {"start_time": 9.03, "end_time": 12.04, "value": 0.4693513520662654}, {"start_time": 12.04, "end_time": 15.05, "value": 0.4659952332878497}, {"start_time": 15.05, "end_time": 18.06, "value": 0.494951996531628}, {"start_time": 18.06, "end_time": 21.07, "value": 0.5440622947023904}, {"start_time": 21.07, "end_time": 24.08, "value": 0.5803928661133704}, {"start_time": 24.08, "end_time": 27.09, "value": 0.6289754642476052}, {"start_time": 27.09, "end_time": 30.1, "value": 0.6201775027120484}, {"start_time": 30.1, "end_time": 33.11, "value": 0.5911656347869643}, {"start_time": 33.11, "end_time": 36.12, "value": 0.5627786272209383}, {"start_time": 36.12, "end_time": 39.13, "value": 0.556193657109234}, {"start_time": 39.13, "end_time": 42.14, "value": 0.5267402442556268}, {"start_time": 42.14, "end_time": 45.15, "value": 0.5306260282874496}, {"start_time": 45.15, "end_time": 48.16, "